#!/bin/bash
# =============================================================================
# Fake systemctl for the container
#
# There is no systemd running as PID 1 in the container: services are run by
# supervisord (see supervisord.conf). The FOG installer still drives services
# through systemctl, so this stub replaces /usr/bin/systemctl and answers every
# command without doing anything. The real binary is kept as
# /usr/bin/systemctl.stock.
#
# `systemctl start/stop ...` therefore does NOTHING, on purpose. To control
# services from scripts:
#   - once supervisord runs : supervisorctl start|stop|restart <program>
#   - before supervisord    : /etc/init.d/<service> start|stop
#
# Exit codes (relied upon by the FOG installer, change with care):
#   - everything succeeds (0) ...
#   - ... except `is-active` / `is-enabled` WITHOUT --quiet, which fail (2)
# =============================================================================

cmd="$1"
shift

# Trace every call in the installer / container output
echo "HOOK - systemctl: $cmd $1 $2"

case "$cmd" in
    # Service and unit management: accept any unit, do nothing
    start|stop|restart|reload|enable|disable|mask|unmask|daemon-reload|daemon-reexec)
        exit 0
        ;;

    # Pretend the unit is running
    status)
        [[ "$1" == "--quiet" ]] && exit 0
        echo "● fake.service - Fake service"
        echo "   Loaded: loaded (/dev/null; fake)"
        echo "   Active: active (running)"
        exit 0
        ;;

    # State queries: --quiet succeeds, the verbose form fails.
    # This mirrors the original hook behaviour the installer was validated with.
    is-active|is-enabled)
        [[ "$1" == "--quiet" ]] && exit 0
        exit 2
        ;;

    # Minimal output so scripts parsing it don't break
    list-units|list-unit-files)
        echo "fake.service loaded active running"
        exit 0
        ;;

    # Anything else is accepted too
    *)
        exit 0
        ;;
esac
