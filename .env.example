# =============================================================================
# docker-fog - optional local settings
#
# Copy this file to .env and uncomment what you need: docker compose loads it
# automatically. Unset variables fall back to the defaults of the compose
# files. .env is git-ignored, keep your personal / test settings there.
# =============================================================================

# --- Build (compose.debug-*.yaml only) ---------------------------------------
#IMAGE_NAME=cpasjuste/fog:dev        # tag of the built image
#FOG_VERSION=1.6.0.158               # FOG release tag (github.com/FOGProject/fogproject/tags)
#UNFS3_VERSION=0.11.0                # unfs3 release (github.com/unfs3/unfs3/releases)

# --- Runtime (all compose files) ---------------------------------------------
#HOST_NAME=fog                       # hostname for the web UI and certificates
#HOST_ADDRESS=192.168.0.1            # server LAN ip
#INTERFACE_NAME=eth0                 # interface for multicast, wol...
#WEB_PASSWORD=password               # web UI "fog" user password
#MYSQL_PASSWORD=dockerfogsql         # database "fogmaster" user password
#STORAGE_PASSWORD=dockerfogstorage   # storage "fogproject" user password (alphanumeric only)

# --- Runtime (compose.debug-*.yaml only) -------------------------------------
#USE_UNFS3=true                      # false: nfs-kernel-server (needs privileged mode)
